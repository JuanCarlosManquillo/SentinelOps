# Configuración de la base de datos
POSTGRES_USER=sentinelops
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=sentinelops

SENTINELOPS_ENVIRONMENT=dev
# Solo en dev: crea tablas al arrancar. En prod se usa Alembic.
SENTINELOPS_AUTO_CREATE_SCHEMA=true

SENTINELOPS_MAX_BATCH_EVENTS=500
SENTINELOPS_MAX_BODY_BYTES=1048576
SENTINELOPS_ERROR_RATE_THRESHOLD=0.2
SENTINELOPS_LATENCY_P95_THRESHOLD_MS=1000